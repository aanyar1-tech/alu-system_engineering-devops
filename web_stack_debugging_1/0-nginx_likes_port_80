#!/usr/bin/env bash
# Stop apache2 to free port 80, configure nginx to listen on port 80, and restart nginx
service apache2 stop
sed -i 's/listen 8080;/listen 80;/g' /etc/nginx/sites-enabled/default
sed -i 's/listen \[::\]:8080;/listen \[::\]:80;/g' /etc/nginx/sites-enabled/default
service nginx restart
