#!/usr/bin/env bash
# Configure Nginx to run as nginx and listen on port 8080
sed -i 's/^user .*/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/listen [0-9]*;/listen 8080;/g' /etc/nginx/sites-available/default
chown -R nginx:nginx /var/log/nginx /var/lib/nginx 2>/dev/null || true
pkill nginx || true
service nginx start
