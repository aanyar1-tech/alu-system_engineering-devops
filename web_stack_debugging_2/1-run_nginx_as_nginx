#!/usr/bin/env bash
# Configure Nginx to run as the nginx user and listen on port 8080 on all IPs

useradd -r -s /sbin/nologin nginx || true

sed -i 's/user www-data;/user nginx;/g' /etc/nginx/nginx.conf
sed -i 's/#user  nobody;/user nginx;/g' /etc/nginx/nginx.conf

sed -i 's/listen 80 default_server;/listen 8080 default_server;/g' /etc/nginx/sites-enabled/default
sed -i 's/listen \[::\]:80 default_server;/listen \[::\]:8080 default_server;/g' /etc/nginx/sites-enabled/default

service nginx restart
