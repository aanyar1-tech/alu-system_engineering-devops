#!/usr/bin/env bash
# Installs Nginx web server, configures the default root page with Holberton School, and starts the service

apt-get update
apt-get install -y nginx

# Ensure the default index page contains the required string
echo "Holberton School for the win!" > /var/www/html/index.html

# Restart Nginx using service instead of systemctl
service nginx restart
