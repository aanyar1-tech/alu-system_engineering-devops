#!/usr/bin/env bash
# Installs Nginx, updates its default root page to contain "Holberton School", and starts it without using systemctl for restarting.

apt-get update -y
apt-get install nginx -y

# Ensure nginx returns "Holberton School for the win!" at the root /
echo "Holberton School for the win!" > /var/www/html/index.nginx-debian.html

# Start nginx directly (since systemctl might not be permitted for restarts)
service nginx start