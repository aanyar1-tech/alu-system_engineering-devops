#!/usr/bin/env bash
# Configure Nginx with a custom 404 error page returning "Ceci n'est pas une page"

# Update and install nginx
apt-get update -y
apt-get install -y nginx

# Create the custom 404 HTML file
echo "Ceci n'est pas une page" > /usr/share/nginx/html/custom_404.html

# Configure Nginx default site to use the custom 404 page
sed -i '/server {/a \    error_page 404 /custom_404.html;\n    location = /custom_404.html {\n        internal;\n    }' /etc/nginx/sites-enabled/default

# Restart Nginx to apply changes
service nginx restart
