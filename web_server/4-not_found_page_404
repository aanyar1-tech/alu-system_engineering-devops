#!/usr/bin/env bash
# Configures Nginx with a custom 404 error page containing "Ceci n'est pas une page" and returning HTTP 404.

# Ensure package lists are updated and Nginx is installed
apt-get update -y
apt-get install -y nginx

# Create the custom 404 HTML file with the exact required string
echo "Ceci n'est pas une page" > /var/www/html/404.html

# Configure Nginx default site to use the custom 404 page via sed
sed -i '/listen 80 default_server;/a \    error_page 404 /404.html;\n    location = /404.html {\n        internal;\n    }' /etc/nginx/sites-available/default

# Restart Nginx using init.d (strictly avoiding systemctl)
/etc/init.d/nginx restart
