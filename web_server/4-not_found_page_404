#!/usr/bin/env bash
# Configure Nginx with a custom 404 error page returning "Ceci n'est pas une page"
apt-get update -y
apt-get install -y nginx
echo "Ceci n'est pas une page" > /usr/share/nginx/html/custom_404.html
sed -i 's/server {/&\n\terror_page 404 \/custom_404.html;\n\tlocation = \/custom_404.html {\n\t\tinternal;\n\t}/' /etc/nginx/sites-available/default
service nginx restart
