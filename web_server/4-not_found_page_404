#!/usr/bin/env bash
# Configure Nginx with a custom 404 error page containing "Ceci n'est pas une page"
apt-get update -y
apt-get install -y nginx
echo "Ceci n'est pas une page" > /usr/share/nginx/html/404.html
sed -i 's/server {/&\n\terror_page 404 \/404.html;/' /etc/nginx/sites-available/default
service nginx restart
