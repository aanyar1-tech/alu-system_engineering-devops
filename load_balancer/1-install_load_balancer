#!/usr/bin/env bash
# Installs and configures HAProxy on lb-01 with roundrobin balancing for web-01 and web-02

# Update package lists and install HAProxy
apt-get update -y
apt-get install haproxy -y

# Enable HAProxy to be managed via init script
sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/haproxy

# Configure HAProxy to load-balance traffic across web-01 and web-02 using roundrobin
cat << 'EOF' >> /etc/haproxy/haproxy.cfg

frontend haproxy_ingress
    bind *:80
    mode http
    default_backend web_backends

backend web_backends
    balance roundrobin
    server web-01 web-01:80 check
    server web-02 web-02:80 check
EOF

# Restart HAProxy service to apply changes
service haproxy restart