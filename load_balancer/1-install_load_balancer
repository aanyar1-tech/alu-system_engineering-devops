#!/usr/bin/env bash
# Install and configure HAProxy with round-robin balancing between web-01 and web-02

apt-get update -y
apt-get install -y haproxy

sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/haproxy

# Append backend configuration to haproxy.cfg
cat << 'CONFIG' >> /etc/haproxy/haproxy.cfg

frontend web-load-balancer
    bind *:80
    mode http
    default_backend web-backend

backend web-backend
    balance roundrobin
    server web-01 34.198.248.145:80 check
    server web-02 54.89.38.100:80 check
CONFIG

service haproxy restart
