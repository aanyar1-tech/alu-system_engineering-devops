#!/usr/bin/env bash
# Install and configure HAProxy on lb-01 with round-robin load balancing to web-01 and web-02

apt-get update
apt-get install -y haproxy

sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/haproxy

cat << 'EOF' >> /etc/haproxy/haproxy.cfg

frontend haproxy_incoming_traffic
    bind *:80
    mode http
    default_backend haproxy_backend_servers

backend haproxy_backend_servers
    mode http
    balance roundrobin
    server web-01 web-01:80 check
    server web-02 web-02:80 check
EOF

service haproxy restart