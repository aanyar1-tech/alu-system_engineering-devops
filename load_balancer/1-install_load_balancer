#!/usr/bin/env bash
# Installs HAProxy and configures roundrobin load balancing for web-01 and web-02
apt-get update
apt-get install -y haproxy

sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/haproxy

cat << 'CONFIG' >> /etc/haproxy/haproxy.cfg

frontend hapr_front
    bind *:80
    default_backend hapr_back

backend hapr_back
    balance roundrobin
    server web-01 54.210.43.155:80 check
    server web-02 54.165.201.9:80 check
CONFIG

service haproxy restart
