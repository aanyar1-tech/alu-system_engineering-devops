#!/usr/bin/env bash
# Install and configure HAProxy with round-robin balancing between web-01 and web-02

# Update package lists and install HAProxy
apt-get update -y
apt-get install -y haproxy

# Enable HAProxy init script execution in default config
sed -i 's/ENABLED=0/ENABLED=1/g' /etc/default/haproxy

# Configure HAProxy /etc/haproxy/haproxy.cfg
cat << 'CONFIG' >> /etc/haproxy/haproxy.cfg

frontend haproxy_incoming_traffic
    bind *:80
    mode http
    default_backend haproxy_backend_servers

backend haproxy_backend_servers
    mode http
    balance roundrobin
    server web-01 34.198.248.145:80 check
    server web-02 54.89.38.100:80 check
CONFIG

# Restart HAProxy to apply configuration changes
service haproxy restart
