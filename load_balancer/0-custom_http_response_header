#!/usr/bin/env bash
# Configure Nginx on an Ubuntu machine to add a custom X-Served-By HTTP response header
# containing the server's hostname.
# shellcheck disable=SC2154

sudo apt-get update -y
sudo apt-get install -y nginx

# Get the server's hostname
HOSTNAME=$(hostname)

# Configure Nginx to add the custom HTTP header X-Served-By
# We use awk or sed to safely insert add_header inside the server block of the default site configuration
CONFIG_FILE="/etc/nginx/sites-available/default"

if ! grep -q "X-Served-By" "$CONFIG_FILE"; then
    sudo sed -i "/server_name _;/a \    add_header X-Served-By $HOSTNAME;" "$CONFIG_FILE"
fi

# Test Nginx configuration and restart service
sudo nginx -t
sudo service nginx restart
