#!/usr/bin/env bash
# shellcheck disable=SC2154
# Installs Nginx and configures a custom X-Served-By HTTP response header with the server hostname

apt-get update
apt-get -y install nginx

# Insert add_header directive right after server { or listen 80 default_server; in Nginx default site configuration
sed -i '/listen 80 default_server;/a \    add_header X-Served-By $hostname;' /etc/nginx/sites-available/default

service nginx restart
