#!/usr/bin/env bash
# shellcheck disable=SC2154
# Configure Nginx to add a custom X-Served-By HTTP response header containing the hostname

# Update package lists and install Nginx if not already installed
apt-get update -y
apt-get install -y nginx

# Get the hostname of the current server
HOSTNAME=$(hostname)

# Add the X-Served-By header inside the http block of nginx.conf if it doesn't already exist
if ! grep -q "add_header X-Served-By" /etc/nginx/nginx.conf; then
    sudo sed -i "/http {/a \ \ \ \ add_header X-Served-By \"$HOSTNAME\";" /etc/nginx/nginx.conf
fi

# Restart Nginx to apply changes
service nginx restart
