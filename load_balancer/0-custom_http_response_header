#!/usr/bin/env bash
# shellcheck disable=SC2154
# Installs Nginx and configures a custom X-Served-By HTTP response header with the server hostname

apt-get update
apt-get -y install nginx

# Insert add_header right after the first 'server {' block in default site configuration
sed -i '/server {/a \    add_header X-Served-By $hostname;' /etc/nginx/sites-available/default

service nginx restart
