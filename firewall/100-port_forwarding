#!/usr/bin/env bash
# Configure ufw port forwarding from port 8080 to port 80
sed -i 's/DEFAULT_FORWARD_POLICY="DROP"/DEFAULT_FORWARD_POLICY="ACCEPT"/' /etc/default/ufw
echo -e "*nat\n:PREROUTING ACCEPT [0:0]\n-A PREROUTING -p tcp --dport 8080 -j REDIRECT --to-ports 80\nCOMMIT\n" | cat - /etc/ufw/before.rules > /tmp/before.rules && mv /tmp/before.rules /etc/ufw/before.rules
ufw reload
